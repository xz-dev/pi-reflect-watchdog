{
  "name": "pi-watchdog",
  "version": "0.1.0",
  "type": "module",
  "description": "Root-agent loop and active-time watchdog for Pi.",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xz-dev/pi-watchdog.git"
  },
  "homepage": "https://github.com/xz-dev/pi-watchdog#readme",
  "bugs": {
    "url": "https://github.com/xz-dev/pi-watchdog/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": ["pi-package", "pi-extension", "pi", "watchdog", "agent"],
  "pi": {
    "extensions": ["./dist/extension.js"]
  },
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "biome check src test",
    "format": "biome format --write src test",
    "test": "tsx --test test/**/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
