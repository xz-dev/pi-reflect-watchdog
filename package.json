{
  "name": "pi-reflect-watchdog",
  "version": "0.1.0",
  "type": "module",
  "description": "Root-agent loop and active-time watchdog for Pi.",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xz-dev/pi-reflect-watchdog.git"
  },
  "homepage": "https://github.com/xz-dev/pi-reflect-watchdog#readme",
  "bugs": {
    "url": "https://github.com/xz-dev/pi-reflect-watchdog/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "watchdog",
    "agent"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "biome check src test scripts",
    "format": "biome format --write src test scripts",
    "test": "npm run test:unit",
    "test:unit": "tsx --test test/*.test.ts",
    "test:e2e:fast": "node scripts/e2e/run-tests.mjs fast",
    "test:e2e": "node scripts/e2e/run-tests.mjs all",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.3.0",
    "@earendil-works/pi-coding-agent": ">=1.3.0",
    "@earendil-works/pi-tui": ">=1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "pi-extension-utils": "git+https://github.com/xz-dev/pi-extension-utils.git#371d47f594b21c75fe82eab95078e71165774199",
    "private-inquiry-subagents-runtime": "git+https://github.com/nicobailon/pi-subagents.git#1008e5993e90fcf13b815c97c15a0c54f7f6f116"
  },
  "trustedDependencies": [
    "pi-extension-utils"
  ],
  "allowScripts": {
    "github:xz-dev/pi-extension-utils#371d47f594b21c75fe82eab95078e71165774199": true
  }
}
